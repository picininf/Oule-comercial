# Chave PÚBLICA (anon) do Supabase — protegida pelo Row Level Security
# configurado em backend/sql/schema.sql. Nunca coloque a service_role
# key aqui, mesmo que "funcione": isso destruiria toda a segurança do app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública do backend (ngrok em dev, domínio fixo em produção)
VITE_API_URL=