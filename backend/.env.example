# ---- Supabase ----
SUPABASE_URL= 
# Chave secreta (service_role). NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Pluggy (Open Finance) ----
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo que VOCE escolhe e envia como header customizado ao criar o Webhook
# na Pluggy (ver scripts/setup-pluggy-webhook.js). Usado para autenticar as
# notificacoes recebidas, ja que a Pluggy nao assina o payload com HMAC.

PLUGGY_WEBHOOK_SECRET=

# URL publica HTTPS do seu backend (ngrok em dev, dominio fixo em producao).
# Usada para registrar o endpoint de webhook na Pluggy.
BACKEND_PUBLIC_URL=


# ---- App ----
PORT=3000
# Origens autorizadas a chamar a API (separadas por virgula, SEM espaco).
# Inclua a origem do navegador (ex.: http://localhost:5173 em dev) E a
# origem que o app Android empacotado com Capacitor usa por padrao:
# https://localhost
# Exemplo:
# ALLOWED_ORIGINS=http://localhost:5173,https://localhost
ALLOWED_ORIGINS=

# ---- Administrador ----
# E-mail que tem acesso ao painel de admin (visão de todos os usuários).
# Qualquer conta do Supabase Auth com este e-mail vira admin automaticamente
# ao logar no app — não é preciso marcar nada em outra tabela.
ADMIN_EMAIL=admin@gmail.com
# Usada apenas pelo script scripts/create-admin-user.js para criar/redefinir
# a senha da conta admin. Não é lida em tempo de execução pelo servidor.
ADMIN_PASSWORD=12345678
