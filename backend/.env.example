# =====================================================================
# Backend — Oule | App
# Copie para .env e preencha. NUNCA versione o .env (já está no .gitignore).
# =====================================================================

# ---- Ambiente ----
# development | production (em produção: HSTS ligado, Open Finance sem sandbox)
NODE_ENV=development
PORT=3000

# ---- Supabase (obrigatório) ----
SUPABASE_URL=
# Chave secreta (service_role). NUNCA exponha no frontend/app.
SUPABASE_SERVICE_ROLE_KEY=

# ---- CORS (obrigatório) ----
# Origens autorizadas a chamar a API, separadas por vírgula, SEM espaço.
# Inclua a origem do navegador (ex.: http://localhost:5173 em dev) E a
# origem do app Android empacotado com Capacitor: https://localhost
ALLOWED_ORIGINS=http://localhost:5173,https://localhost

# ---- Administrador ----
# E-mail da conta "oule" (admin raiz). Ela só vira admin depois de ter o
# e-mail CONFIRMADO no Supabase Auth. Sem valor = ninguém vira admin
# automaticamente (promova pela tabela profiles).
ADMIN_EMAIL=
# Usada SOMENTE pelo script `npm run admin:criar`. Mínimo 12 caracteres.
# Apague daqui depois de criar a conta.
ADMIN_PASSWORD=

# ---- Gemini (IA de leitura de comprovantes e extratos em PDF/foto) ----
# Planilhas (CSV/XLS/XLSX/OFX) são lidas SEM IA; a chave só é necessária
# para PDF, foto e o comando !imagem do WhatsApp.
GEMINI_API_KEY=

# ---- Pluggy (Open Finance) ----
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo que VOCÊ escolhe e envia como header customizado ao criar o
# Webhook na Pluggy (npm run setup:webhook). A Pluggy não assina o payload
# com HMAC; este segredo é a autenticação das notificações.
PLUGGY_WEBHOOK_SECRET=
# URL pública HTTPS do backend (ngrok em dev, domínio fixo em produção).
BACKEND_PUBLIC_URL=

# ---- WhatsApp / lembretes ----
# Pasta da sessão do bot (é uma CREDENCIAL — fica fora do git).
WHATSAPP_AUTH_DIR=auth_info_baileys
# true = não sobe o bot (útil em dev/testes ou em uma 2ª instância)
WHATSAPP_DESATIVADO=false
# true = não envia lembretes de vencimento pelo WhatsApp
LEMBRETES_DESATIVADOS=false
