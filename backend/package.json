{
  "name": "gestao-financeira-backend",
  "version": "2.0.0",
  "type": "module",
  "description": "Backend do Oule | App — gestão financeira com planejador, Open Finance, importação de extratos e assistente no WhatsApp",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/verificar-sintaxe.js",
    "setup:webhook": "node scripts/setup-pluggy-webhook.js",
    "admin:criar": "node scripts/create-admin-user.js",
    "normalizar:categorias": "node scripts/normalizar-categorias.js",
    "sync:item": "node scripts/sincronizar-item.js",
    "test": "node --import ./tests/setup.js --experimental-test-module-mocks --test tests/regras.test.js tests/plano.test.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.45.4",
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "pluggy-sdk": "^0.51.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  }
}
